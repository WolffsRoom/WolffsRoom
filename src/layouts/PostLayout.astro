---
import BaseLayout from './BaseLayout.astro';
const { data } = Astro.props;
---
<BaseLayout title={data.title} description={data.description} image={data.cover}>
  <article class="post-single-container">
    <a class="back" href={`/${data.category}/`}>← Voltar</a>
    <span class="post-category-tag">{data.category}</span>
    <h1 class="post-single-title">{data.title}</h1>
    <p class="post-single-subtitle">{data.description}</p>
    <img class="post-featured-image" src={data.cover} alt={`Capa de ${data.title}`} />
    <div class="post-content"><slot /></div>
  </article>
</BaseLayout>
