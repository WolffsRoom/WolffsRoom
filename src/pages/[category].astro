---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
export function getStaticPaths() {
  const categories = { traducoes: ['Traduções', 'Traduções em português brasileiro'], mods: ['Mods', 'Modificações e patches'], ports: ['Ports', 'Projetos adaptados para novas plataformas'], analises: ['Análises', 'Opiniões e avaliações de jogos'] };
  return Object.entries(categories).map(([category, copy]) => ({ params: { category }, props: { copy } }));
}
const { category } = Astro.params;
const { copy } = Astro.props;
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.category === category)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={copy[0]} description={copy[1]}><div class="main-body-content"><div class="section-badge-title"><h2>{copy[0].toUpperCase()}</h2></div><section class="section-block"><div class="cards-grid-wolf">{posts.map((post) => <PostCard post={post} />)}</div>{posts.length === 0 && <div class="content-page-box"><p>Nenhuma publicação cadastrada nesta categoria.</p></div>}</section></div></BaseLayout>
